# 실제 모델 호출에 쓰는 키. 없으면 서버는 "모델 호출 꺼짐"으로 뜨고 저장된 상담 기록만 보여 준다.
# ANTHROPIC_API_KEY=

# auto(기본): 키가 있으면 live, 없으면 off / scripted: 규칙 엔진(LLM 아님, 개발·테스트용)
# BATONDESK_LLM_MODE=auto
# BATONDESK_AGENT_MODEL=claude-haiku-5-5
# BATONDESK_JUDGE_MODEL=claude-haiku-5-5

# 프롬프트 버전을 manifest.yaml 의 active 와 다르게 쓰고 싶을 때
# BATONDESK_AGENT_PROMPT=agent-v1

# 근거 검사 방식: block(걸리면 고객에게 내보내지 않음) / flag(내보내되 표시) / off
# BATONDESK_GROUNDING_MODE=block

# 공개 데모 보호
# BATONDESK_DAILY_USD_CAP=1.5
# BATONDESK_RATE_LIMIT_PER_HOUR=40
